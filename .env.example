# Optional: omit both variables to use browser-based offline sign translation.
# If configured, the FastAPI server is preferred while its /health endpoint is reachable.

# Local FastAPI backend (optional)
# VITE_API_BASE=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000/ws/stream

# Production FastAPI backend (optional)
# VITE_API_BASE=https://your-backend.onrender.com
# VITE_WS_URL=wss://your-backend.onrender.com/ws/stream

# Required for Supabase sign-in/sign-up
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
